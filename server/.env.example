# ==============================================================================
# 🏥 CLÍNICA SAAS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instrucciones:
# Copia este archivo como `.env` y configura credenciales seguras.
# En producción/staging el validador estricto (validateEnv.js) abortará el inicio
# si detecta secretos vacíos, débiles o contraseñas por defecto.
# ==============================================================================

# ==============================================================================
# 1. ENTORNO Y APLICACIÓN
# ==============================================================================
# Opciones: development | staging | production | test
NODE_ENV=development
PORT=5000

# URL pública de la API Backend
API_URL=http://localhost:5000

# URL pública del Frontend Client (Angular 21)
CLIENT_URL=http://localhost:4200

# Orígenes permitidos para CORS (separados por coma, sin comodín '*' en producción)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5000,https://staging.tu-clinica.com,https://tu-clinica.com

# ==============================================================================
# 2. SEGURIDAD Y TOKENS (OBLIGATORIOS EN PRODUCCIÓN)
# ==============================================================================
# Secreto para JWT (En producción: MÍNIMO 32 caracteres criptográficamente seguros)
# Generar con: openssl rand -hex 32
JWT_SECRET=reemplazar_con_secreto_hexadecimal_de_al_menos_32_caracteres_2026

# Tiempo de expiración del token JWT (ej. 8h, 24h, 7d)
JWT_EXPIRES_IN=8h

# Secreto para endpoints administrativos de inicialización
INIT_SECRET=reemplazar_con_un_secreto_fuerte_de_inicializacion_2026

# Clave simétrica para cifrado AES-256-GCM de secretos 2FA/TOTP y datos sensibles (MÍNIMO 32 caracteres)
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=reemplazar_con_clave_aes256_hex_de_al_menos_32_caracteres_2026

# ⚠️ PELIGRO: NUNCA habilitar en producción (aborta el arranque si NODE_ENV=production)
ALLOW_DB_RESET=false

# ==============================================================================
# 3. BASE DE DATOS POSTGRESQL (ROW LEVEL SECURITY & MULTI-TENANCY)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=clinica_saas_bd
DB_USER=clinica_saas_admin
DB_PASSWORD=reemplazar_con_password_segura_de_postgres_2026
DB_SSL=false
# Esquema opcional para separación multi-esquema (develop / staging / production):
# DB_SCHEMA=public

# Pool de conexiones PostgreSQL
DB_POOL_MAX=20
DB_POOL_MIN=2

# Opcional: URL completa de conexión (sobrescribe los parámetros anteriores si se define):
# DATABASE_URL=postgresql://usuario:password@localhost:5432/clinica_saas_bd

# ==============================================================================
# 4. ALMACENAMIENTO DE ARCHIVOS Y DOCUMENTOS MÉDICOS (FASE 3)
# ==============================================================================
# Driver de almacenamiento: local | s3
STORAGE_DRIVER=local

# Directorio privado seguro (fuera de la raíz web pública, protegido contra descargas directas)
STORAGE_DIR=./storage/secure

# Secreto para firma HMAC de URLs de descarga temporales
FILE_SIGNING_SECRET=reemplazar_con_secreto_para_firmas_de_archivos_32_chars

# Tamaño máximo de archivo en bytes (ej. 10485760 = 10MB)
MAX_FILE_SIZE_BYTES=10485760

# Configuración opcional para S3 / MinIO / Cloudflare R2 (si STORAGE_DRIVER=s3):
# S3_BUCKET=clinica-saas-attachments
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=tu_access_key
# S3_SECRET_ACCESS_KEY=tu_secret_key

# ==============================================================================
# 5. MENSAJERÍA Y CORREO ELECTRÓNICO (SMTP / RESEND)
# ==============================================================================
# Opción A: Resend API
# RESEND_API_KEY=re_tu_api_key_aqui

# Opción B: Servidor SMTP corporativo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=tu_correo@clinicasaas.app
SMTP_PASSWORD=tu_password_de_aplicacion
FROM_NAME="Clínica SaaS"
FROM_EMAIL=no-reply@clinicasaas.app

# ==============================================================================
# 6. OBSERVABILIDAD Y REGISTRO (LOGGING)
# ==============================================================================
# Niveles soportados: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
