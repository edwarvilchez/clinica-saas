# ===============================================
# CLÍNICA SAAS - Environment Variables
# ===============================================
# Copy this file to .env and update with your values

# ===============================================
# SECURITY CONFIGURATION
# ===============================================
INIT_SECRET=your_secure_init_secret_here
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5000,https://tu-dominio.com
ALLOW_DB_RESET=false  # Set to true ONLY in local development to enable DB reset endpoints

# ===============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinica_saas_bd
DB_USER=clinica_saas_admin
DB_PASSWORD=your_secure_db_password_here
# Optional full connection string:
# DATABASE_URL=postgresql://clinica_saas_admin:your_secure_db_password_here@localhost:5432/clinica_saas_bd

# ===============================================
# JWT CONFIGURATION
# ===============================================
JWT_SECRET=your_jwt_secret_here

# ===============================================
# EMAIL CONFIGURATION (SMTP or Resend)
# ===============================================
RESEND_API_KEY=re_your_api_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_smtp_password
FROM_NAME=Clínica SaaS
FROM_EMAIL=no-reply@tu-dominio.com

# ===============================================
# APPLICATION CONFIGURATION
# ===============================================
PORT=5000
NODE_ENV=development
# NODE_ENV=production  # Uncomment for production

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:4200

# API URL (for Swagger docs)
API_URL=http://localhost:5000

# ===============================================
# LOGGING CONFIGURATION
# ===============================================
# Levels: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
