# ==============================================================================
# Docker Ignore - Clinica SaaS Root Context
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment and sensitive secrets
.env
.env.*
!.env.example
!server/.env.example

# Git metadata
.git/
.gitignore
.gitattributes

# Test suites, fixtures and coverage
test/
tests/
__tests__/
**/__tests__/
coverage/
*.test.js
*.spec.js
.jest/

# Storage, uploads and backups
uploads/
storage/
backups/
**/uploads/
**/storage/
**/backups/

# Client build artifacts
client/dist/

# Documentation and development files
*.md
docs/
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
